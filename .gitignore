# Tout est ignoré par défaut : seuls le code, les outils et les données du site sont versionnés.
# Les médias (images, modèles, sons, vidéos…) ne sont pas dans Git : ils sont distribués dans la Release « ressources-v1 ».
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Ouvrir le site.bat
!/Installer les ressources.bat
!/tools/
!/Site/

# Site : code + données générées seulement
/Site/*
!/Site/index.html
!/Site/app.js
!/Site/style.css
!/Site/viewer3d.js
!/Site/shader_preview.js
!/Site/serveur.py
!/Site/lib/
!/Site/data/

__pycache__/
*.pyc
node_modules/

# caches et fichiers générés par les outils
/tools/*.json
/tools/*.txt
!/tools/requirements.txt
/tools/*.pkl
/tools/venv/
/tools/vgmstream/
/release/
/.ressources_installees
